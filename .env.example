# Copy to .env.local (gitignored) for local development.
#
# The spreadsheet id is NOT stored in this repository. Encode it yourself:
#
#   printf '%s' '<spreadsheet-id>' | base64
#
# In CI the same value comes from the repository secret SHEET_ID_B64
# (Settings -> Secrets and variables -> Actions). See docs/DESIGN.md section 9.1.
#
# Base64 here is obfuscation, not protection: it keeps the id out of code search
# and out of a grep of the deployed bundle. Anyone who opens the running page's
# network tab still sees it. The sheet's sharing setting is the real control.

VITE_SHEET_ID_B64=
